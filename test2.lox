var a = "global";

{
  var a = "block";
  print (a); // Should print "block"
}

print (a); // Should print "global"

var a = "one";

fun outer() {
  var a = "two";

  fun inner() {
    print (a);  // Should print "two"
  }

  inner();
}

outer();


{
var a = "outside";

fun show() {
  print ("in/out "+a);
}
{
  var a = "inside";
  show(); // Should still print "outside"
}
}


var a = "top";

{
    var a = "block";
    print (a); // expect: block
}
print (a); // expect: top


var a = "before";
fun update() {
    a = "after";
}
update();
print (a); // expect: after


